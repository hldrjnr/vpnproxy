{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Proxy Toggle",
  "version": "1.0.0",
  "identifier": "com.hldr.proxytoggle",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Proxy Toggle",
        "width": 392,
        "height": 532,
        "minWidth": 392,
        "minHeight": 532,
        "maxWidth": 392,
        "maxHeight": 532,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 https://api.ipify.org; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
